# Настройки LLM-моста танка. Скопируйте в .env и заполните своими значениями.
# .env НЕ коммитится (см. .gitignore).

# MAC-адрес Bluetooth-модуля HC-06 на танке
TANK_BT_ADDR=AA:BB:CC:DD:EE:FF
# PIN спаривания HC-06 (по умолчанию 1234)
TANK_BT_PIN=1234
# Последовательный порт (macOS): /dev/cu.HC-06
TANK_SERIAL_PORT=/dev/cu.HC-06
# Скорость UART
TANK_BAUD=9600

# Бэкенд LLM: "openai" (llama-swap в LAN) или "ollama" (локально)
TANK_LLM_BACKEND=openai
# Модель на сервере
TANK_MODEL=Qwen3.8-FN-IQ3-S-Basalt
# OpenAI-совместимый endpoint
TANK_OPENAI_URL=http://<llm-сервер>:8080/v1/chat/completions
# API-ключ сервера
TANK_OPENAI_KEY=вставьте-ключ
# Локальная Ollama (запасной вариант)
TANK_OLLAMA_URL=http://localhost:11434/api/chat
